# Optional SDK installation: pip install -e ".[dev,llm]"
# Supply these variables to the process (or load your private .env yourself).
# The resolver does not automatically load .env files.
OPENAI_API_KEY=
# Required: choose the team's model, preferably an exact snapshot identifier.
TRACEMEM_RESOLVER_MODEL=
TRACEMEM_RESOLVER_TIMEOUT_SECONDS=30
# Total attempts per candidate, including the initial request; allowed range 1-5.
TRACEMEM_RESOLVER_MAX_ATTEMPTS=2
TRACEMEM_RESOLVER_MAX_COMPLETION_TOKENS=1024
# Optional, omitted from requests by default for models that do not support it.
# TRACEMEM_RESOLVER_TEMPERATURE=0
