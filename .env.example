# Optional SDK installation: pip install -e ".[dev,llm]"
# Supply these variables to the process (or load your private .env yourself).
# Only OPENROUTER_API_KEY is read from a .env file in the folder you run from,
# and only when it is absent from the process environment.
OPENAI_API_KEY=
# Required: choose the team's model, preferably an exact snapshot identifier.
TRACEMEM_RESOLVER_MODEL=
TRACEMEM_RESOLVER_TIMEOUT_SECONDS=30
# Total attempts per candidate, including the initial request; allowed range 1-5.
TRACEMEM_RESOLVER_MAX_ATTEMPTS=2
TRACEMEM_RESOLVER_MAX_COMPLETION_TOKENS=1024
# Optional, omitted from requests by default for models that do not support it.
# TRACEMEM_RESOLVER_TEMPERATURE=0
# All three controlled comparison systems use the same resolver settings above
# for write decisions AND answers. Mem0 requires pip install -e ".[dev,mem0]".
# This is a UTF-8 byte budget for memory context (not a model-token estimate).
TRACEMEM_CONTEXT_BUDGET_BYTES=12000
# Model provider for the controlled comparison systems (docs/local-model.md):
# openai (the default; uses OPENAI_API_KEY), openrouter, or local (an Ollama server).
TRACEMEM_PROVIDER=openai
OPENROUTER_API_KEY=
# Local server address, and whether the model may think before answering (on/off).
TRACEMEM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
TRACEMEM_LOCAL_THINKING=off
# The context in tokens the local server must give the model (its OLLAMA_CONTEXT_LENGTH).
# It is checked after every reply; a mismatch or a cut request stops the run.
TRACEMEM_LOCAL_CONTEXT_TOKENS=16384
# Saved replies make a repeated request free. off neither reads nor saves replies,
# but calls are still logged and capped. The cost log is calls.jsonl in the cache folder.
TRACEMEM_CACHE=on
TRACEMEM_CACHE_DIR=cache/llm
# Spending cap in US dollars, summed over the whole cost log. It counts only priced
# calls: OpenRouter's reported cost, or the price table in src/tracemem/model_client.py.
# Other calls, including every call through the default openai provider, are logged
# as unpriced at zero, so the cap does not limit them. Local calls are never capped.
TRACEMEM_BUDGET_USD=12
# Embedding model on the local server, for similarity retrieval.
TRACEMEM_EMBED_MODEL=nomic-embed-text
